# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Brain model (Groq). Options: openai/gpt-oss-120b (smart), openai/gpt-oss-20b (fastest)
JARVIS_MODEL=openai/gpt-oss-120b
# How hard the model thinks before answering: low | medium | high (low = fastest)
JARVIS_REASONING_EFFORT=low
# What JARVIS calls you
JARVIS_USER_NAME=sir
JARVIS_MAX_HISTORY=20
JARVIS_SHOW_TIMING=true

# --- Voice (Phase 1) ---
# Speech-to-text model on Groq
JARVIS_STT_MODEL=whisper-large-v3-turbo
# Text-to-speech engine: kokoro (natural, local) | say (macOS built-in) | none
JARVIS_TTS=kokoro
# Kokoro British voices: bm_george, bm_lewis, bm_daniel, bm_fable (female: bf_emma, bf_alice, bf_isabella, bf_lily)
JARVIS_VOICE=bm_george
JARVIS_SPEECH_SPEED=1.0
# int8 model is ~2x faster; kokoro-v1.0.onnx is the full-precision version
JARVIS_KOKORO_MODEL=models/kokoro-v1.0.int8.onnx
JARVIS_KOKORO_VOICES=models/voices-v1.0.bin

# --- Hands-free (Phase 2) ---
# Wake word sensitivity 0-1: lower = triggers more easily (and more false alarms)
JARVIS_WAKE_THRESHOLD=0.5
# How long you must be quiet before JARVIS decides you've finished (lower = snappier, may cut you off)
JARVIS_SILENCE_SECONDS=0.8
# After the chime: how long to wait for you to start talking
JARVIS_LISTEN_TIMEOUT=8
# After JARVIS answers: how long to keep listening for a follow-up before going back to sleep
JARVIS_FOLLOWUP_SECONDS=6
